{
  "name": "@marineverse/cli",
  "version": "0.1.2",
  "description": "MarineVerse races, boats, and account access from your terminal",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marineverse/marineverse-cli.git"
  },
  "homepage": "https://github.com/marineverse/marineverse-cli#readme",
  "bugs": {
    "url": "https://github.com/marineverse/marineverse-cli/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "marineverse": "bin/marineverse.js"
  },
  "exports": {
    ".": "./dist/cli.js"
  },
  "files": [
    "bin/",
    "dist/",
    "skills/marineverse/SKILL.md",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "check:release": "npm run build && node scripts/check-release.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:package": "npm run build && node scripts/test-package.mjs",
    "release": "node scripts/release.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.1.0",
    "commander": "15.0.0"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "7.0.2"
  }
}
