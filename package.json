{
  "name": "@marineverse/cli",
  "version": "0.1.0",
  "description": "MarineVerse races, boats, and account access from your terminal",
  "type": "module",
  "license": "Apache-2.0",
  "engines": { "node": ">=24" },
  "bin": { "marineverse": "bin/marineverse.js" },
  "exports": { ".": "./dist/cli.js" },
  "files": ["bin/", "dist/", "skills/marineverse/SKILL.md", "README.md", "LICENSE", "NOTICE", "THIRD_PARTY_NOTICES"],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "check:release": "npm run build && node scripts/check-release.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:package": "npm run build && node scripts/test-package.mjs",
    "prepack": "npm run build"
  },
  "dependencies": { "commander": "15.0.0", "@napi-rs/keyring": "2.1.0" },
  "devDependencies": { "@types/node": "24.19.0", "typescript": "7.0.2" }
}
